<!-- A cabinet with one sliding drawer. Origin: bottom centre of the cabinet; the drawer opens towards -x.
     Attached by the platform with the object's name as prefix: joint <name>_slide, site <name>_grip. -->
<mujoco model="drawer">
  <default>
    <geom solref="0.004 1" solimp="0.99 0.999 0.0005 0.5 2" friction="0.8 0.005 0.0001" condim="4"/>
  </default>
  <worldbody>
    <body name="cabinet">
      <geom name="floor" type="box" size="0.12 0.12 0.005" pos="0 0 0.005" rgba="0.55 0.42 0.3 1"/>
      <geom name="top" type="box" size="0.12 0.12 0.005" pos="0 0 0.095" rgba="0.55 0.42 0.3 1"/>
      <geom name="left" type="box" size="0.12 0.005 0.04" pos="0 0.115 0.05" rgba="0.5 0.38 0.27 1"/>
      <geom name="right" type="box" size="0.12 0.005 0.04" pos="0 -0.115 0.05" rgba="0.5 0.38 0.27 1"/>
      <geom name="back" type="box" size="0.005 0.11 0.04" pos="0.115 0 0.05" rgba="0.5 0.38 0.27 1"/>
      <body name="drawer" pos="0 0 0.012">
        <joint name="slide" type="slide" axis="-1 0 0" range="0 0.18" damping="8" frictionloss="2"/>
        <geom name="d_bottom" type="box" size="0.105 0.105 0.004" pos="0 0 0.004" rgba="0.8 0.75 0.65 1" mass="0.12"/>
        <geom name="d_front" type="box" size="0.005 0.108 0.036" pos="-0.115 0 0.038" rgba="0.85 0.8 0.7 1" mass="0.06"/>
        <geom name="d_left" type="box" size="0.105 0.004 0.03" pos="0 0.101 0.038" rgba="0.8 0.75 0.65 1" mass="0.04"/>
        <geom name="d_right" type="box" size="0.105 0.004 0.03" pos="0 -0.101 0.038" rgba="0.8 0.75 0.65 1" mass="0.04"/>
        <geom name="d_back" type="box" size="0.004 0.105 0.03" pos="0.101 0 0.038" rgba="0.8 0.75 0.65 1" mass="0.04"/>
        <!-- handle: a vertical tab the gripper closes on from above (fingers along y), then pulls towards -x -->
        <geom name="handle" type="box" size="0.025 0.006 0.02" pos="-0.145 0 0.045" rgba="0.2 0.2 0.22 1" mass="0.02"
              friction="1.2 0.005 0.0001"/>
        <site name="grip" pos="-0.15 0 0.05" size="0.004" rgba="0 0 0 0"/>
      </body>
    </body>
  </worldbody>
  <contact>
    <exclude body1="cabinet" body2="drawer"/>
  </contact>
</mujoco>
